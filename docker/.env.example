# Images for docker-compose.yml. Copy this file to .env in this directory
# (`cp .env.example .env`) and fill in both values. Docker Compose reads .env
# on every command, so `up`, `ps`, `logs` and `down` all see them. While a
# value is empty, Compose stops with "missing a value: see docker/README.md".
#
# No images are published, so build them yourself (see README.md).

# For example qbit-explorer-frontend:local
QBIT_EXPLORER_FRONTEND_IMAGE=

# For example qbit-explorer-backend:local
QBIT_EXPLORER_BACKEND_IMAGE=
