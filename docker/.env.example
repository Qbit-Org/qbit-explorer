# Settings for docker-compose.yml. Copy this file to .env in this directory
# (`cp .env.example .env`) and fill in the values below. Docker Compose reads
# .env on every command, so `up`, `ps`, `logs` and `down` all see them. While
# a value that docker-compose.yml reads is empty, Compose stops with "missing
# a value: see docker/README.md".
#
# No images are published, so build them yourself (see README.md).

# For example qbit-explorer-frontend:local
QBIT_EXPLORER_FRONTEND_IMAGE=

# For example qbit-explorer-backend:local
QBIT_EXPLORER_BACKEND_IMAGE=

# qbitd's RPC login: the user name and password of an rpcauth line in
# qbit.conf (see README.md). Use the password that qbit's rpcauth.py
# generates, or one of your own with only letters, digits, - and _. The
# backend image copies it into its config with sed, which breaks on !, &
# and \, a " breaks the config's JSON, and Compose reads a $ here as a
# variable.
#
# To use qbitd's RPC cookie instead, replace the CORE_RPC_USERNAME and
# CORE_RPC_PASSWORD lines in docker-compose.yml as README.md shows.
# docker-compose.yml then doesn't read these two, so delete them.
CORE_RPC_USERNAME=
CORE_RPC_PASSWORD=
